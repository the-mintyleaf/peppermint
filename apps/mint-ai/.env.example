# ============================================================================
# sAgent v2 Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the required values
# DO NOT commit .env to git (use .env.example as template)
#
# For local development, copy this file:
#   cp .env.example .env
#
# Then edit .env with your local values
# ============================================================================

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# Controls logging level, error handling, and feature flags
# Options: development | staging | production
NODE_ENV=development

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port for Fastify API server
VAGENT_PORT=3000

# CORS allowed origins (comma-separated, space-trimmed)
# Use "*" for development only (NOT for production)
# Format: http://localhost:3000,http://localhost:3001
VAGENT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Allow null origin in CORS (for electron apps, file:// protocols)
# Set to "1" to allow, "0" or unset to disallow
VAGENT_CORS_ALLOW_NULL=0

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis connection URL for ephemeral storage, job queues, and session memory
# Format: redis://[username:password@]host[:port][/database]
#
# Local Redis (development):
VAGENT_REDIS_URL=redis://localhost:6379

# Production example (with auth):
# VAGENT_REDIS_URL=redis://:your-password@redis-prod.example.com:6379/0

# Redis database number (0-15)
# VAGENT_REDIS_DB=0

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level for console and file output
# Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Path for log files (relative or absolute)
# Logs will be written to: {VAGENT_LOG_PATH}/app.log
VAGENT_LOG_PATH=./logs

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================
# Number of worker processes for job queue processing
# Recommendation:
#   - Development: 2-5 (low CPU usage)
#   - Production: number of CPU cores
VAGENT_WORKER_CONCURRENCY=5

# Max attempts to retry failed jobs
# BullMQ default is 5, increase for unreliable networks
VAGENT_WORKER_MAX_RETRIES=5

# ============================================================================
# LLM PROVIDERS - API KEYS
# ============================================================================

# DEEPSEEK LLM API KEY
# Get your key from: https://platform.deepseek.com/api/keys
# Required for agents.reasoning node with deepseek.chat model
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OPENAI API KEY (for future use)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ANTHROPIC CLAUDE API KEY (for future use)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Default LLM model for reasoning nodes
# Options: deepseek.chat (implemented), openai (planned), claude (planned)
VAGENT_DEFAULT_MODEL=deepseek.chat

# Default temperature for LLM sampling
# Range: 0.0 - 2.0
# 0.0 = deterministic (same response every time)
# 1.0 = balanced creativity/consistency
# 2.0 = maximum randomness
VAGENT_DEFAULT_TEMPERATURE=0.7

# Default max tokens per run (hard limit)
# Helps control costs and prevent runaway generations
VAGENT_DEFAULT_MAX_TOKENS=5000

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
# Max number of messages to keep in session memory
# Older messages are dropped to prevent token bloat
VAGENT_SESSION_MEMORY_LIMIT=20

# Session TTL (Time To Live) in seconds
# After this time, session data is auto-deleted from Redis
# 86400 = 24 hours
VAGENT_SESSION_TTL=86400

# ============================================================================
# WORKFLOW CONFIGURATION
# ============================================================================
# Max execution duration per workflow run (milliseconds)
# Prevents long-running jobs from consuming resources indefinitely
# 300000 = 5 minutes
VAGENT_MAX_RUN_DURATION=300000

# Max tool-calling loops per reasoning node
# Prevents infinite tool loops (reasoning → tool → reasoning → ...)
VAGENT_MAX_TOOL_LOOPS=3

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Allowed API hosts for tool.apiCall executor
# Comma-separated list of domains that tools can call
# Use wildcards: *.example.com, api.*.com, etc.
VAGENT_ALLOWED_API_HOSTS=api.example.com,*.internal.example.com

# API call timeout (milliseconds)
# 10000 = 10 seconds
VAGENT_API_CALL_TIMEOUT=10000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# API authentication token (for securing /v1/runs endpoints)
# Set a strong random value in production
# Generate with: openssl rand -hex 32
VAGENT_API_TOKEN=your-secure-api-token-here

# Django backend URL (for long-term memory, audit logs)
# Used by memory.session.fetch and memory.session.update nodes
VAGENT_DJANGO_URL=http://localhost:8000
VAGENT_DJANGO_API_TOKEN=your-django-api-token

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable debug mode (verbose logging, detailed error responses)
# Set to "1" to enable, "0" or unset to disable
VAGENT_DEBUG=0

# Enable metrics collection
# Set to "1" to enable, "0" or unset to disable
VAGENT_ENABLE_METRICS=1

# Enable SSE streaming (Server-Sent Events)
# Set to "1" to enable, "0" or unset to disable
VAGENT_ENABLE_SSE_STREAMING=1

# ============================================================================
# DATABASE & PERSISTENCE (Optional)
# ============================================================================
# For long-term memory and audit logs (future feature)
# DATABASE_URL=postgresql://user:password@localhost:5432/sagent

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/123456

# Datadog API key for metrics (optional)
# DATADOG_API_KEY=your-datadog-api-key

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# Enable hot reload (for development)
# VAGENT_HOT_RELOAD=1

# Mock mode (use fake LLM responses for testing)
# VAGENT_MOCK_LLM=0

# ============================================================================
# NOTES
# ============================================================================
#
# Development vs Production:
#   - Development: Use localhost, small worker count, debug=1
#   - Production: Use managed services, scale workers, debug=0
#
# Required fields (without defaults):
#   - DEEPSEEK_API_KEY (if using deepseek model)
#   - VAGENT_REDIS_URL (if not using localhost:6379)
#
# Security best practices:
#   - Never commit .env to git
#   - Use different values for dev/staging/prod
#   - Rotate API keys regularly
#   - Store secrets in secure vault (not plain text)
#   - Use strong VAGENT_API_TOKEN in production
#
# Troubleshooting:
#   - If Redis connection fails: check VAGENT_REDIS_URL
#   - If LLM calls fail: check DEEPSEEK_API_KEY and NODE_ENV
#   - If logging is too verbose: decrease LOG_LEVEL
#   - If workers overwhelm: decrease VAGENT_WORKER_CONCURRENCY
#
# ============================================================================
